S_RAG_OLLAMA_HOST=http://127.0.0.1:11434
S_RAG_GENERATION_MODEL=qwen3:4b
S_RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
S_RAG_CHUNK_SIZE_TOKENS=600
S_RAG_CHUNK_OVERLAP_TOKENS=80
S_RAG_DEFAULT_TOP_K=4
S_RAG_GENERATION_CONTEXT_TOKENS=4096
S_RAG_MAX_OUTPUT_TOKENS=512
S_RAG_MAX_FILE_SIZE_MB=25

# Optional TypeSafe evidence governor. Copy this file to .env, add the key there,
# and enable only after running the local tests and live probe.
TYPESAFE_API_KEY=
S_RAG_TYPESAFE_ENABLED=false
S_RAG_TYPESAFE_MODEL=jev-latest
S_RAG_TYPESAFE_CANDIDATE_TOP_K=12
S_RAG_TYPESAFE_MAX_WORKERS=4
S_RAG_TYPESAFE_TIMEOUT_SECONDS=30
